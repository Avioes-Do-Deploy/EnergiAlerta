{
  "type": "module",
  "name": "backend",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "scripts": {
    "start": "npm run build:ts && fastify start -l info dist/app.js",
    "build:ts": "tsc",
    "watch:ts": "tsc -w",
    "dev": "fastify start -l info src/app.ts",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js",
    "prisma:pull": "pnpm prisma db pull",
    "prisma:mig": "pnpm prisma migrate dev",
    "prisma:gen": "pnpm prisma generate && node -e \"const fs = require('fs'); const file = 'src/generated/zod/schemas/aggregateusers.schema.ts'; if (fs.existsSync(file)) { fs.writeFileSync(file, fs.readFileSync(file, 'utf8').replace(/usersAggregateArgs/g, 'UsersAggregateArgs')); }\"",
    "prisma:setup": "pnpm prisma:gen && pnpm prisma:mig",
    "prisma:std": "pnpm prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/autoload": "^6.4.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/env": "^7.0.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/sensible": "^6.0.4",
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@prisma/client-runtime-utils": "^7.9.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.10.0",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^5.1.0",
    "prisma-zod-generator": "^2.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.5",
    "c8": "^11.0.0",
    "concurrently": "^9.2.4",
    "dotenv": "^17.4.2",
    "fastify-tsconfig": "^3.0.0",
    "prisma": "^7.9.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
